{
  "name": "payload-phone-number",
  "version": "0.1.0",
  "description": "A Payload CMS v4 phone number field powered by libphonenumber-js.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "payload": "^4.0.0",
    "@payloadcms/ui": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "payload": "^4.0.0",
    "@payloadcms/ui": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AF111/payload-phone-number.git"
  },
  "homepage": "https://github.com/AF111/payload-phone-number#readme",
  "bugs": {
    "url": "https://github.com/AF111/payload-phone-number/issues"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "phone",
    "phone-number",
    "libphonenumber",
    "e164"
  ],
  "engines": {
    "node": ">=20"
  }
}
